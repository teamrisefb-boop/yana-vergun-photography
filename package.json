{
  "name": "yana-vergun-photography",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:phone": "node scripts/build-phone.mjs",
    "build:images": "node scripts/build-images.mjs && node scripts/update-image-markup.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build:motion": "node scripts/build-motion.mjs",
    "preview": "node scripts/preview.mjs",
    "test:ui": "node --test tests/ui.browser.test.mjs",
    "test:motion": "node --test tests/motion.browser.test.mjs",
    "review:motion": "node scripts/record-motion-review.mjs",
    "measure": "node scripts/measure-performance.mjs",
    "test": "node --test tests/worker.test.mjs tests/telegram-group.test.mjs",
    "test:browser": "node --test tests/booking.browser.test.mjs",
    "worker:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir .wrangler/check",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "telegram:setup": "node scripts/setup-telegram.mjs",
    "telegram:group": "node scripts/setup-telegram-group.mjs --bot YanaVergun_bot"
  },
  "devDependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "esbuild": "0.28.2",
    "gsap": "3.12.5",
    "lighthouse": "^13.6.0",
    "parse5": "^8.0.1",
    "playwright": "1.64.1",
    "sharp": "^0.35.5",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.15"
  }
}
