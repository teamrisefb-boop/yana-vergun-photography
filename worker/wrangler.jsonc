{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "yana-vergun-booking",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "BOOKING_IP_LIMIT", "namespace_id": "29461001", "simple": { "limit": 3, "period": 60 } },
    { "name": "BOOKING_SITE_LIMIT", "namespace_id": "29461002", "simple": { "limit": 30, "period": 60 } }
  ]
}
